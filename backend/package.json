{
  "name": "navix-management-api",
  "version": "1.0.0",
  "description": "Navix Management — Backend API SaaS de gestion de flotte de véhicules",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "db:migrate": "node src/database/scripts/cli.js migrate",
    "db:migrate:status": "node src/database/scripts/cli.js status",
    "db:rollback": "node src/database/scripts/cli.js rollback",
    "db:seed": "node src/database/scripts/cli.js seed",
    "db:reset": "node src/database/scripts/reset.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
