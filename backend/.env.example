# Server
NODE_ENV=development
PORT=8000

# API
API_PREFIX=/api/v1

# Database — MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=navix_management
DB_USER=root
DB_PASSWORD=

# JWT Authentication
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Legacy JWT keys (fallback)
JWT_SECRET=
REFRESH_TOKEN_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Navix Management <noreply@navix.app>

# Auth Security
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=15

# CORS
CORS_ORIGIN=http://localhost:5173

# Uploads
UPLOADS_DIR=./uploads
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=debug
